# ============================================================
# Assis MotoTáxi — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA faça commit do arquivo .env com segredos reais.
# ============================================================

# Porta HTTP do servidor (padrão 8780)
PORT=8780

# Segredo das sessões e URLs assinadas.
# Se omitido, um segredo aleatório é gerado e persistido em data/.secret
# SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Bootstrap do primeiro administrador (criado apenas se nenhum admin existir).
# Se omitidos, um admin "admin@assismototaxi.local" é criado na primeira
# execução com senha aleatória IMPRESSA UMA ÚNICA VEZ no console.
# ADMIN_EMAIL=dono@exemplo.com.br
# ADMIN_PASSWORD=senha-forte-aqui

# Caminho do banco SQLite (padrão: data/assis.db)
# DB_PATH=data/assis.db
# As cópias de segurança automáticas ficam em <pasta do banco>/backups.

# ------------------------------------------------------------
# PROXY E HTTPS (produção)
# Fly.io, Render e afins colocam um proxy na frente do app. Com
# TRUST_PROXY=1 o app passa a usar o IP real do cliente (Fly-Client-IP ou o
# último X-Forwarded-For) no limite de tentativas, e X-Forwarded-Proto para
# marcar o cookie de sessão como Secure e enviar HSTS.
# NÃO ligue sem um proxy na frente: qualquer cliente poderia forjar o IP.
# TRUST_PROXY=1
#
# Força o cookie Secure mesmo sem proxy informando HTTPS (ex.: TLS terminado
# por outro serviço que não manda X-Forwarded-Proto).
# COOKIE_SECURE=1

# ------------------------------------------------------------
# GOOGLE MAPS (mapa, rotas de moto e busca de lojas pelo nome).
# O jeito recomendado é colar as chaves na central → 🗺️ Mapas (ficam
# cifradas no banco). Exige faturamento ativo no Google Cloud e as APIs:
# Maps JavaScript, Routes, Places (New) e Geocoding.
#
# Chave do navegador: vai ao navegador (é pública por natureza). Restrinja
# por site no Google Cloud.
# GOOGLE_MAPS_BROWSER_KEY=AIza...
#
# Chave de servidor (opcional): só se a do navegador tiver restrição de
# site. Nunca vai ao navegador.
# GOOGLE_MAPS_SERVER_KEY=

# ------------------------------------------------------------
# MAPBOX (mapa, rotas e busca de endereços). Usado quando não há chave do
# Google, ou como reserva dele.
# O jeito recomendado é colar o token na central → 🗺️ Mapas (fica cifrado
# no banco). As variáveis abaixo são alternativa para deploy automatizado.
# Crie a conta e copie o token em https://account.mapbox.com/
#
# Token PÚBLICO (começa com "pk."): vai ao navegador para desenhar o mapa.
# Restrinja por URL (seu domínio) na conta Mapbox. Nunca coloque aqui um
# token secreto ("sk.") — ele é ignorado.
# MAPBOX_PUBLIC_TOKEN=pk....
#
# Token de SERVIDOR (opcional): só é necessário se o token público tiver
# restrição de URL. Crie um segundo token sem restrição; nunca vai ao navegador.
# MAPBOX_SERVER_TOKEN=
#
# Sem token o sistema usa OpenStreetMap/OSRM automaticamente.
#
# NÚMEROS DE CASA (opcional): chave do Google com a Geocoding API ativada.
# Faz "rua + número" cair na casa certa. Só o backend usa; exige faturamento
# ativo no Google Cloud. Também pode ser colada na central → 🗺️ Mapas.
# GOOGLE_GEOCODING_KEY=
# ------------------------------------------------------------

# ------------------------------------------------------------
# Reserva gratuita (usada quando não há token do Mapbox).
# Em produção com volume alto, hospede seu próprio OSRM/Nominatim.
# ------------------------------------------------------------
# OSRM_BASE=https://router.project-osrm.org
# NOMINATIM_BASE=https://nominatim.openstreetmap.org

# Força modo offline de geocodificação/rotas (útil em testes): 1 = sem rede
# GEO_OFFLINE=0

# ------------------------------------------------------------
# PAGAMENTOS — Mercado Pago (Pix e cartão).
# Sem estas chaves o sistema roda em MODO DE TESTE, claramente identificado
# na interface. Nenhum valor real é movimentado e nenhuma aprovação acontece
# sozinha. Obtenha em https://www.mercadopago.com.br/developers (Suas
# integrações > Credenciais de produção).
# ------------------------------------------------------------
# MP_ACCESS_TOKEN=APP_USR-...
# MP_PUBLIC_KEY=APP_USR-...        # necessária para cobrar no cartão
# MP_WEBHOOK_SECRET=...            # "Assinatura secreta" do webhook
# URL pública do sistema (usada no notification_url do provedor)
# PUBLIC_URL=https://seudominio.com.br

# ------------------------------------------------------------
# Notificações push (Web Push/VAPID). As chaves são geradas sozinhas em
# data/vapid.json; só o contato é configurável.
# ------------------------------------------------------------
# PUSH_CONTACT=mailto:contato@seudominio.com.br

# ------------------------------------------------------------
# Login com Google (OPCIONAL — login por e-mail/senha já funciona).
# Crie credenciais OAuth 2.0 em https://console.cloud.google.com/apis/credentials
# Tipo: "Web application"; origem autorizada: http://localhost:8780
# Enquanto não configurado, o botão Google informa indisponibilidade.
# ------------------------------------------------------------
# GOOGLE_CLIENT_ID=
