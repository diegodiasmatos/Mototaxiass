# ============================================================
# Assis MotoTáxi — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA faça commit do arquivo .env com segredos reais.
# ============================================================

# Porta HTTP do servidor (padrão 8780)
PORT=8780

# Segredo das sessões e URLs assinadas.
# Se omitido, um segredo aleatório é gerado e persistido em data/.secret
# SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Bootstrap do primeiro administrador (criado apenas se nenhum admin existir).
# Se omitidos, um admin "admin@assismototaxi.local" é criado na primeira
# execução com senha aleatória IMPRESSA UMA ÚNICA VEZ no console.
# ADMIN_EMAIL=dono@exemplo.com.br
# ADMIN_PASSWORD=senha-forte-aqui

# Caminho do banco SQLite (padrão: data/assis.db)
# DB_PATH=data/assis.db

# ------------------------------------------------------------
# Serviços de geolocalização (padrões públicos e gratuitos).
# Em produção com volume alto, hospede seu próprio OSRM/Nominatim
# ou troque pela Google Maps Platform (ver README).
# ------------------------------------------------------------
# OSRM_BASE=https://router.project-osrm.org
# NOMINATIM_BASE=https://nominatim.openstreetmap.org

# Força modo offline de geocodificação/rotas (útil em testes): 1 = sem rede
# GEO_OFFLINE=0

# ------------------------------------------------------------
# PAGAMENTOS — Mercado Pago (Pix e cartão).
# Sem estas chaves o sistema roda em MODO DE TESTE, claramente identificado
# na interface. Nenhum valor real é movimentado e nenhuma aprovação acontece
# sozinha. Obtenha em https://www.mercadopago.com.br/developers (Suas
# integrações > Credenciais de produção).
# ------------------------------------------------------------
# MP_ACCESS_TOKEN=APP_USR-...
# MP_PUBLIC_KEY=APP_USR-...        # necessária para cobrar no cartão
# MP_WEBHOOK_SECRET=...            # "Assinatura secreta" do webhook
# URL pública do sistema (usada no notification_url do provedor)
# PUBLIC_URL=https://seudominio.com.br

# ------------------------------------------------------------
# Notificações push (Web Push/VAPID). As chaves são geradas sozinhas em
# data/vapid.json; só o contato é configurável.
# ------------------------------------------------------------
# PUSH_CONTACT=mailto:contato@seudominio.com.br

# ------------------------------------------------------------
# Login com Google (OPCIONAL — login por e-mail/senha já funciona).
# Crie credenciais OAuth 2.0 em https://console.cloud.google.com/apis/credentials
# Tipo: "Web application"; origem autorizada: http://localhost:8780
# Enquanto não configurado, o botão Google informa indisponibilidade.
# ------------------------------------------------------------
# GOOGLE_CLIENT_ID=
